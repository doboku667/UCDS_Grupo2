    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# -*- coding: utf-8 -*-\n\"\"\"\nNODO 01 - LEER Y VALIDAR REGLAS\n===============================\nRutina QA/QC de parámetros y nomenclatura - EC2 MBIM301\n\nEntradas\n    IN[0]  ruta del archivo CSV de reglas (str)\n\nSalida\n    OUT = [reglas, errores]\n        reglas  : list[list[str]]  una fila por regla válida, en el orden de COLUMNAS\n        errores : list[str]        filas rechazadas y el motivo\n\nEste nodo NO toca el modelo de Revit. Si una regla está mal escrita\n(columna vacía, operador desconocido, expresión regular inválida...)\nse descarta aquí y se reporta, en lugar de fallar a mitad de la auditoría.\n\nCompatible con los motores CPython3 / PythonNet3 (Dynamo 2.13+ / 3.x).\n\"\"\"\nimport csv\nimport io\nimport re\n\nCOLUMNAS = [\n    \"id\", \"tipo\", \"categoria\", \"parametro\", \"operador\", \"valor\",\n    \"filtro_parametro\", \"filtro_operador\", \"filtro_valor\",\n    \"sobrescribir\", \"severidad\", \"descripcion\",\n]\n\n# Operadores permitidos por tipo de regla\nOPERADORES = {\n    \"VERIFICAR\": (\"NO_VACIO\", \"IGUAL\", \"EN_LISTA\", \"REGEX\"),\n    \"ASIGNAR\": (\"FIJAR\",),\n}\nOPERADORES_FILTRO = (\"\", \"CONTIENE\", \"IGUAL\", \"EN_LISTA\", \"REGEX\", \"NO_VACIO\")\nSEVERIDADES = (\"ALTA\", \"MEDIA\", \"BAJA\")\n\n\ndef leer_texto(ruta):\n    \"\"\"Lee el CSV aceptando UTF-8 (con o sin BOM) y ANSI/Windows-1252,\n    que es lo que guarda Excel en Windows en español.\"\"\"\n    try:\n        with io.open(ruta, \"r\", encoding=\"utf-8-sig\") as f:\n            return f.read()\n    except UnicodeDecodeError:\n        with io.open(ruta, \"r\", encoding=\"cp1252\") as f:\n            return f.read()\n\n\ndef _regex_valida(patron):\n    try:\n        re.compile(patron)\n        return True\n    except re.error:\n        return False\n\n\ndef validar_regla(r, ids_vistos):\n    \"\"\"Devuelve None si la regla es válida o un texto con el problema.\"\"\"\n    if not r[\"id\"]:\n        return \"falta el id\"\n    if r[\"id\"] in ids_vistos:\n        return \"id duplicado\"\n    if r[\"tipo\"] not in OPERADORES:\n        return \"tipo '%s' no válido (use VERIFICAR o ASIGNAR)\" % r[\"tipo\"]\n    if not r[\"categoria\"].startswith(\"OST_\"):\n        return \"categoría '%s' debe ser un BuiltInCategory (ej. OST_Walls)\" % r[\"categoria\"]\n    if not r[\"parametro\"]:\n        return \"falta el parámetro\"\n    if r[\"operador\"] not in OPERADORES[r[\"tipo\"]]:\n        return \"operador '%s' no válido para %s (use %s)\" % (\n            r[\"operador\"], r[\"tipo\"], \", \".join(OPERADORES[r[\"tipo\"]]))\n    if r[\"operador\"] != \"NO_VACIO\" and not r[\"valor\"]:\n        return \"falta el valor\"\n    if r[\"operador\"] == \"REGEX\" and not _regex_valida(r[\"valor\"]):\n        return \"expresión regular inválida en 'valor'\"\n    if r[\"tipo\"] == \"ASIGNAR\" and r[\"parametro\"].upper() == \"TIPO:NOMBRE\":\n        return \"no se permite renombrar tipos con ASIGNAR\"\n    if r[\"filtro_operador\"] not in OPERADORES_FILTRO:\n        return \"filtro_operador '%s' no válido\" % r[\"filtro_operador\"]\n    if bool(r[\"filtro_operador\"]) != bool(r[\"filtro_parametro\"]):\n        return \"filtro incompleto: indique filtro_parametro y filtro_operador juntos\"\n    if r[\"filtro_operador\"] not in (\"\", \"NO_VACIO\") and not r[\"filtro_valor\"]:\n        return \"falta filtro_valor\"\n    if r[\"filtro_operador\"] == \"REGEX\" and not _regex_valida(r[\"filtro_valor\"]):\n        return \"expresión regular inválida en 'filtro_valor'\"\n    if r[\"severidad\"] not in SEVERIDADES:\n        return \"severidad '%s' no válida (ALTA, MEDIA o BAJA)\" % r[\"severidad\"]\n    if r[\"sobrescribir\"] not in (\"SI\", \"NO\"):\n        return \"sobrescribir debe ser SI o NO\"\n    return None\n\n\ndef parsear_reglas(texto):\n    \"\"\"Convierte el texto del CSV en (reglas, errores).\"\"\"\n    lineas = [l for l in texto.splitlines()\n              if l.strip() and not l.lstrip().startswith(\"#\")]\n    if not lineas:\n        return [], [\"El archivo de reglas está vacío.\"]\n\n    # Excel en configuración regional Perú/España separa con ';'\n    delim = \";\" if lineas[0].count(\";\") >= lineas[0].count(\",\") else \",\"\n    filas = list(csv.reader(lineas, delimiter=delim))\n\n    encabezado = [c.strip().lower() for c in filas[0]]\n    faltan = [c for c in COLUMNAS if c not in encabezado]\n    if faltan:\n        return [], [\"Faltan columnas en el encabezado: \" + \", \".join(faltan)]\n    idx = dict((c, encabezado.index(c)) for c in COLUMNAS)\n\n    reglas, errores, ids = [], [], set()\n    for n, fila in enumerate(filas[1:], start=2):\n        fila = fila + [\"\"] * (len(encabezado) - len(fila))\n        r = dict((c, fila[idx[c]].strip()) for c in COLUMNAS)\n        for c in (\"tipo\", \"operador\", \"filtro_operador\", \"severidad\", \"sobrescribir\"):\n            r[c] = r[c].upper()\n        r[\"severidad\"] = r[\"severidad\"] or \"MEDIA\"\n        r[\"sobrescribir\"] = (r[\"sobrescribir\"] or \"NO\").replace(\"SÍ\", \"SI\")\n\n        problema = validar_regla(r, ids)\n        if problema:\n            errores.append(\"Fila %d (%s): %s\" % (n, r[\"id\"] or \"sin id\", problema))\n            continue\n        ids.add(r[\"id\"])\n        reglas.append([r[c] for c in COLUMNAS])\n\n    if not reglas:\n        errores.append(\"No quedó ninguna regla válida.\")\n    return reglas, errores\n\n\ndef ejecutar(ruta):\n    if not ruta:\n        return [[], [\"No se indicó el archivo de reglas.\"]]\n    try:\n        texto = leer_texto(str(ruta))\n    except (IOError, OSError) as ex:\n        return [[], [\"No se pudo leer el archivo de reglas: %s\" % ex]]\n    reglas, errores = parsear_reglas(texto)\n    return [reglas, errores]\n\n\n# --- Punto de entrada del nodo Python de Dynamo --------------------------\nif \"IN\" in globals():\n    OUT = ejecutar(IN[0])  # noqa: F821  (IN lo define Dynamo)\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "8574527ee8e05ba582bc90ab804ddac1",
          "Name": "IN[0]",
          "Description": "Ruta CSV de reglas",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "6a076fbf092055ae8c327af228f39bac",
          "Name": "OUT",
          "Description": "Resultado del script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Description": "Ejecuta un script de Python incrustado.",
      "Id": "352f4f6a6571559aa7f1a4df8d769754",
      "Replication": "Disabled"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# -*- coding: utf-8 -*-\n\"\"\"\nNODO 02 - AUDITAR Y CORREGIR (Revit API)\n========================================\nRutina QA/QC de parámetros y nomenclatura - EC2 MBIM301\n\nEntradas\n    IN[0]  salida completa del NODO 01: [reglas, errores]\n    IN[1]  escribir (bool)  False = solo auditar, NO modifica el modelo\n    IN[2]  resaltar (bool)  True  = colorea en la vista activa:\n                                     rojo = falla / pendiente / error\n                                     ámbar = omitido (grupo, solo lectura, prestado)\n                                     sin color = cumple\n\nSalida\n    OUT = [tabla, resumen, mensaje, proyecto]\n        tabla    : list[list]  detalle elemento por regla (1.ª fila = encabezado)\n        resumen  : list[list]  cumplimiento por regla (1.ª fila = encabezado)\n        mensaje  : str         resumen legible para el Watch / Dynamo Player\n        proyecto : str         título del modelo (para nombrar el reporte)\n\nResultados posibles por fila\n    OK         cumple la regla\n    CORREGIDO  la rutina escribió el valor (solo con escribir = True)\n    PENDIENTE  no cumple y se corregiría con escribir = True\n    FALLA      no cumple una regla de VERIFICAR\n    OMITIDO    no se pudo escribir por una condición controlada\n    ERROR      excepción de la API o parámetro inexistente\n    INFO       la categoría no tiene elementos en el modelo\n\nCompatible con los motores CPython3 / PythonNet3 (Revit 2022-2026).\n\"\"\"\nimport re\n\nimport clr\nclr.AddReference(\"RevitAPI\")\nclr.AddReference(\"RevitServices\")\nimport Autodesk.Revit.DB as DB  # noqa: E402\nfrom RevitServices.Persistence import DocumentManager  # noqa: E402\nfrom RevitServices.Transactions import TransactionManager  # noqa: E402\n\nCOLUMNAS_REGLA = [\n    \"id\", \"tipo\", \"categoria\", \"parametro\", \"operador\", \"valor\",\n    \"filtro_parametro\", \"filtro_operador\", \"filtro_valor\",\n    \"sobrescribir\", \"severidad\", \"descripcion\",\n]\nENCABEZADO = [\n    \"regla_id\", \"severidad\", \"categoria\", \"element_id\", \"unique_id\",\n    \"familia_tipo\", \"parametro\", \"origen\", \"valor_actual\", \"valor_esperado\",\n    \"resultado\", \"detalle\",\n]\nESTADOS = [\"OK\", \"CORREGIDO\", \"PENDIENTE\", \"FALLA\", \"OMITIDO\", \"ERROR\"]\nROJO = (\"PENDIENTE\", \"FALLA\", \"ERROR\")\nAMBAR = (\"OMITIDO\",)\n\n\n# ---------------------------------------------------------------------------\n# Lógica pura (sin Revit) - probada con pytest en /tests\n# ---------------------------------------------------------------------------\ndef cumple(valor, operador, esperado):\n    \"\"\"Evalúa un valor (texto) contra un operador de la regla.\"\"\"\n    valor = (valor or \"\").strip()\n    esperado = (esperado or \"\").strip()\n    op = (operador or \"\").upper()\n    if op == \"NO_VACIO\":\n        return valor != \"\"\n    if op == \"IGUAL\":\n        return valor.lower() == esperado.lower()\n    if op == \"CONTIENE\":\n        return esperado.lower() in valor.lower()\n    if op == \"EN_LISTA\":\n        return valor.lower() in [x.strip().lower() for x in esperado.split(\"|\") if x.strip()]\n    if op == \"REGEX\":\n        return re.search(esperado, valor) is not None\n    raise ValueError(\"Operador no soportado: %s\" % operador)\n\n\ndef resumir(filas):\n    \"\"\"Tabla de cumplimiento por regla + fila TOTAL.\"\"\"\n    orden, conteo, desc = [], {}, {}\n    for f in filas:\n        rid, res = f[0], f[10]\n        if rid not in conteo:\n            orden.append(rid)\n            conteo[rid] = dict((e, 0) for e in ESTADOS)\n        if res in conteo[rid]:\n            conteo[rid][res] += 1\n    encabezado = [\"regla_id\", \"evaluados\"] + ESTADOS + [\"cumplimiento_%\"]\n    tabla = [encabezado]\n    total = dict((e, 0) for e in ESTADOS)\n    for rid in orden:\n        c = conteo[rid]\n        n = sum(c.values())\n        for e in ESTADOS:\n            total[e] += c[e]\n        tabla.append([rid, n] + [c[e] for e in ESTADOS] + [_pct(c, n)])\n    n_total = sum(total.values())\n    tabla.append([\"TOTAL\", n_total] + [total[e] for e in ESTADOS] + [_pct(total, n_total)])\n    return tabla\n\n\ndef _pct(c, n):\n    if n == 0:\n        return \"\"\n    return round(100.0 * (c[\"OK\"] + c[\"CORREGIDO\"]) / n, 1)\n\n\n# ---------------------------------------------------------------------------\n# Utilidades de Revit API\n# ---------------------------------------------------------------------------\ndef id_entero(element_id):\n    \"\"\"ElementId -> int. Revit 2024+ usa .Value; versiones previas .IntegerValue.\"\"\"\n    try:\n        return int(element_id.Value)\n    except AttributeError:\n        return int(element_id.IntegerValue)\n\n\ndef nombre_de_tipo(tipo):\n    \"\"\"Nombre del tipo sin depender de .Name (falla en CPython3 con FamilySymbol).\"\"\"\n    if tipo is None:\n        return \"\"\n    for nombre_bip in (\"SYMBOL_NAME_PARAM\", \"ALL_MODEL_TYPE_NAME\"):\n        bip = getattr(DB.BuiltInParameter, nombre_bip, None)\n        if bip is None:\n            continue\n        p = tipo.get_Parameter(bip)\n        if p is not None and p.HasValue:\n            s = p.AsString()\n            if s:\n                return s\n    try:\n        return tipo.Name\n    except Exception:\n        return \"\"\n\n\ndef familia_y_tipo(tipo):\n    nombre = nombre_de_tipo(tipo)\n    try:\n        familia = tipo.FamilyName if tipo is not None else \"\"\n    except Exception:\n        familia = \"\"\n    return \"%s: %s\" % (familia, nombre) if familia else nombre\n\n\ndef valor_texto(p):\n    \"\"\"Valor del parámetro como texto, sea String, Integer, Double o ElementId.\"\"\"\n    if p is None or not p.HasValue:\n        return \"\"\n    st = p.StorageType\n    if st == DB.StorageType.String:\n        return p.AsString() or \"\"\n    if st == DB.StorageType.ElementId:\n        if p.AsElementId() == DB.ElementId.InvalidElementId:\n            return \"\"\n        return p.AsValueString() or \"\"\n    v = p.AsValueString()\n    if v:\n        return v\n    if st == DB.StorageType.Integer:\n        return str(p.AsInteger())\n    if st == DB.StorageType.Double:\n        return str(p.AsDouble())\n    return \"\"\n\n\ndef fijar_valor(p, texto):\n    \"\"\"Escribe respetando el tipo de almacenamiento. Devuelve True si Revit lo aceptó.\"\"\"\n    st = p.StorageType\n    if st == DB.StorageType.String:\n        return bool(p.Set(texto))\n    if st == DB.StorageType.Integer:\n        return bool(p.Set(int(texto)))\n    if st == DB.StorageType.Double:\n        # SetValueString interpreta el texto en las unidades del proyecto\n        return bool(p.SetValueString(texto))\n    return False  # ElementId: no se asigna por texto\n\n\ndef resolver_lector(spec):\n    \"\"\"Convierte 'BIP:FIRE_RATING' / 'TIPO:NOMBRE' / 'Nombre visible' en una función.\n    Los BuiltInParameter no dependen del idioma de Revit; los nombres visibles sí.\"\"\"\n    s = spec.strip()\n    if s.upper() == \"TIPO:NOMBRE\":\n        return \"TIPO:NOMBRE\"\n    if s.upper().startswith(\"BIP:\"):\n        bip = getattr(DB.BuiltInParameter, s[4:].strip(), None)\n        if bip is None:\n            raise ValueError(\"BuiltInParameter desconocido: %s\" % s)\n        return lambda e: e.get_Parameter(bip)\n    return lambda e: e.LookupParameter(s)\n\n\ndef buscar_parametro(el, tipo, lector):\n    \"\"\"Busca primero en la instancia y luego en el tipo.\n    Devuelve (parametro, origen, valor_texto, existe).\"\"\"\n    if lector == \"TIPO:NOMBRE\":\n        return None, \"tipo\", nombre_de_tipo(tipo), True\n    for origen, e in ((\"instancia\", el), (\"tipo\", tipo)):\n        if e is None:\n            continue\n        p = lector(e)\n        if p is not None:\n            return p, origen, valor_texto(p), True\n    return None, \"\", \"\", False\n\n\ndef prestado_por_otro(doc, elemento):\n    \"\"\"True si en un modelo colaborativo el elemento lo tiene otro usuario\n    o está desactualizado respecto al central (escribir generaría conflicto).\"\"\"\n    if not doc.IsWorkshared:\n        return False\n    try:\n        if DB.WorksharingUtils.GetCheckoutStatus(doc, elemento.Id) == DB.CheckoutStatus.OwnedByOtherUser:\n            return True\n        estado = DB.WorksharingUtils.GetModelUpdatesStatus(doc, elemento.Id)\n        return estado == DB.ModelUpdatesStatus.UpdatedInCentral\n    except Exception:\n        return False\n\n\n# ---------------------------------------------------------------------------\n# Motor de reglas\n# ---------------------------------------------------------------------------\nclass Auditoria(object):\n    def __init__(self, doc, escribir):\n        self.doc = doc\n        self.escribir = escribir\n        self.filas = []\n        self.estado_elemento = {}   # id_int -> (ElementId, peor estado)\n        self.tipos_escritos = {}    # (regla_id, id_tipo) -> valor escrito\n\n    def fila(self, r, el=None, tipo_txt=\"\", origen=\"\", actual=\"\", esperado=\"\",\n             resultado=\"OK\", detalle=\"\"):\n        eid, uid = \"\", \"\"\n        if el is not None:\n            eid = id_entero(el.Id)\n            uid = el.UniqueId\n            self._marcar(el.Id, eid, resultado)\n        self.filas.append([r[\"id\"], r[\"severidad\"], r[\"categoria\"], eid, uid, tipo_txt,\n                           r[\"parametro\"], origen, actual, esperado, resultado, detalle])\n\n    def _marcar(self, element_id, eid, resultado):\n        previo = self.estado_elemento.get(eid)\n        rango = {\"OK\": 0, \"CORREGIDO\": 0, \"INFO\": 0, \"OMITIDO\": 1}\n        if previo is None or rango.get(resultado, 2) > rango.get(previo[1], 2):\n            self.estado_elemento[eid] = (element_id, resultado)\n\n    def procesar(self, r):\n        bic = getattr(DB.BuiltInCategory, r[\"categoria\"], None)\n        if bic is None:\n            self.fila(r, resultado=\"ERROR\", detalle=\"Categoría no existe en esta versión de Revit\")\n            return\n        try:\n            lector = resolver_lector(r[\"parametro\"])\n            lector_filtro = resolver_lector(r[\"filtro_parametro\"]) if r[\"filtro_parametro\"] else None\n        except ValueError as ex:\n            self.fila(r, resultado=\"ERROR\", detalle=str(ex))\n            return\n\n        elementos = list(DB.FilteredElementCollector(self.doc).OfCategory(bic)\n                         .WhereElementIsNotElementType().ToElements())\n        evaluados = 0\n        for el in elementos:\n            try:\n                tipo = self.doc.GetElement(el.GetTypeId())\n                if lector_filtro is not None:\n                    _, _, v_filtro, existe = buscar_parametro(el, tipo, lector_filtro)\n                    if not existe or not cumple(v_filtro, r[\"filtro_operador\"], r[\"filtro_valor\"]):\n                        continue\n                evaluados += 1\n                if r[\"tipo\"] == \"VERIFICAR\":\n                    self._verificar(r, el, tipo, lector)\n                else:\n                    self._asignar(r, el, tipo, lector)\n            except Exception as ex:  # una excepción no detiene la auditoría\n                self.fila(r, el, resultado=\"ERROR\", detalle=\"Excepción: %s\" % ex)\n\n        if evaluados == 0:\n            detalle = (\"Ningún elemento cumple el filtro\" if lector_filtro is not None\n                       else \"La categoría no tiene elementos en el modelo\")\n            self.fila(r, resultado=\"INFO\", detalle=detalle)\n\n    def _verificar(self, r, el, tipo, lector):\n        p, origen, actual, existe = buscar_parametro(el, tipo, lector)\n        tipo_txt = familia_y_tipo(tipo)\n        esperado = r[\"valor\"] or \"(no vacío)\"\n        if not existe:\n            self.fila(r, el, tipo_txt, \"\", \"\", esperado, \"ERROR\",\n                      \"Parámetro inexistente en instancia y tipo\")\n        elif cumple(actual, r[\"operador\"], r[\"valor\"]):\n            self.fila(r, el, tipo_txt, origen, actual, esperado, \"OK\")\n        else:\n            self.fila(r, el, tipo_txt, origen, actual, esperado, \"FALLA\", r[\"descripcion\"])\n\n    def _asignar(self, r, el, tipo, lector):\n        p, origen, actual, existe = buscar_parametro(el, tipo, lector)\n        tipo_txt = familia_y_tipo(tipo)\n        nuevo = r[\"valor\"]\n        f = lambda res, det=\"\": self.fila(r, el, tipo_txt, origen, actual, nuevo, res, det)\n\n        if not existe:\n            return f(\"ERROR\", \"Parámetro inexistente en instancia y tipo\")\n        dueno = el if origen == \"instancia\" else tipo\n        clave_tipo = (r[\"id\"], id_entero(tipo.Id)) if origen == \"tipo\" and tipo is not None else None\n\n        if clave_tipo in self.tipos_escritos:\n            return f(\"CORREGIDO\", \"Asignado a nivel de tipo (afecta a todas sus instancias)\")\n        if actual.strip() and r[\"sobrescribir\"] == \"NO\":\n            return f(\"OK\", \"Ya tenía valor; no se sobrescribe\")\n        if actual.strip() == nuevo.strip():\n            return f(\"OK\")\n        if not self.escribir:\n            return f(\"PENDIENTE\", \"Se asignaría '%s' (modo auditoría)\" % nuevo)\n        if p.IsReadOnly:\n            return f(\"OMITIDO\", \"Parámetro de solo lectura\")\n        if origen == \"instancia\" and el.GroupId != DB.ElementId.InvalidElementId:\n            return f(\"OMITIDO\", \"Elemento dentro de un grupo: editar el grupo manualmente\")\n        if prestado_por_otro(self.doc, dueno):\n            return f(\"OMITIDO\", \"Elemento tomado por otro usuario o desactualizado (sincronizar)\")\n        try:\n            ok = fijar_valor(p, nuevo)\n        except Exception as ex:\n            return f(\"ERROR\", \"Revit rechazó el valor: %s\" % ex)\n        if not ok:\n            return f(\"ERROR\", \"Revit rechazó el valor (tipo de dato incompatible)\")\n        if clave_tipo is not None:\n            self.tipos_escritos[clave_tipo] = nuevo\n        f(\"CORREGIDO\", \"Valor asignado\" + (\" al tipo\" if origen == \"tipo\" else \"\"))\n\n    def resaltar(self):\n        \"\"\"Colorea el resultado en la vista activa. Devuelve un texto de estado.\"\"\"\n        vista = self.doc.ActiveView\n        if vista is None or not vista.AreGraphicsOverridesAllowed():\n            return \"Vista activa no admite modificaciones gráficas (plantilla o tipo de vista)\"\n        solido = None\n        for fp in DB.FilteredElementCollector(self.doc).OfClass(DB.FillPatternElement):\n            if fp.GetFillPattern().IsSolidFill:\n                solido = fp.Id\n                break\n\n        def ogs(r, g, b):\n            o = DB.OverrideGraphicSettings()\n            color = DB.Color(r, g, b)\n            o.SetProjectionLineColor(color)\n            if solido is not None:\n                o.SetSurfaceForegroundPatternId(solido)\n                o.SetSurfaceForegroundPatternColor(color)\n            return o\n\n        rojo, ambar, limpio = ogs(220, 40, 40), ogs(240, 160, 0), DB.OverrideGraphicSettings()\n        pintados, fallidos = 0, 0\n        for element_id, estado in self.estado_elemento.values():\n            o = rojo if estado in ROJO else ambar if estado in AMBAR else limpio\n            try:\n                vista.SetElementOverrides(element_id, o)\n                pintados += 1\n            except Exception:\n                fallidos += 1\n        return \"Vista '%s': %d elementos coloreados%s\" % (\n            vista.Name, pintados, (\", %d no admitidos\" % fallidos) if fallidos else \"\")\n\n\ndef ejecutar(salida_nodo01, escribir, resaltar):\n    reglas_raw, errores_reglas = [], []\n    try:\n        salida_nodo01 = list(salida_nodo01 or [])  # tolera listas .NET de Dynamo\n        if len(salida_nodo01) == 2:\n            reglas_raw = [list(f) for f in (salida_nodo01[0] or [])]\n            errores_reglas = [str(e) for e in (salida_nodo01[1] or [])]\n    except TypeError:\n        errores_reglas = [\"La entrada IN[0] no es la salida del NODO 01\"]\n    reglas = [dict(zip(COLUMNAS_REGLA, fila)) for fila in reglas_raw if len(fila) == len(COLUMNAS_REGLA)]\n    if not reglas:\n        msg = (\"SIN REGLAS VÁLIDAS: no se auditó el modelo ni se generó reporte.\\n\"\n               \"Motivo: \" + (\" | \".join(errores_reglas) or \"el NODO 01 no devolvió reglas\") + \"\\n\"\n               \"Verifique la ruta del archivo de reglas en el grupo 1 · ENTRADAS.\")\n        return [[ENCABEZADO], resumir([]), msg, \"\"]\n\n    doc = DocumentManager.Instance.CurrentDBDocument\n    escribir, resaltar = bool(escribir), bool(resaltar)\n    auditoria = Auditoria(doc, escribir)\n    estado_vista = \"\"\n\n    necesita_transaccion = escribir or resaltar\n    if necesita_transaccion:\n        TransactionManager.Instance.EnsureInTransaction(doc)\n    try:\n        for r in reglas:\n            auditoria.procesar(r)\n        if resaltar:\n            estado_vista = auditoria.resaltar()\n    finally:\n        if necesita_transaccion:\n            TransactionManager.Instance.TransactionTaskDone()\n\n    resumen = resumir(auditoria.filas)\n    total = resumen[-1]\n    partes = [\n        \"Modelo: %s\" % doc.Title,\n        \"Modo: %s\" % (\"CORRECCIÓN\" if escribir else \"AUDITORÍA (sin cambios)\"),\n        \"Reglas aplicadas: %d\" % len(reglas),\n        \"Evaluaciones: %s\" % total[1],\n        \"Cumplimiento global: %s%%\" % total[-1],\n        \"Corregidos: %s | Pendientes: %s | Fallas: %s | Omitidos: %s | Errores: %s\" % tuple(total[3:8]),\n    ]\n    if errores_reglas:\n        partes.append(\"Reglas descartadas: %d (ver NODO 01)\" % len(errores_reglas))\n    if estado_vista:\n        partes.append(estado_vista)\n    return [[ENCABEZADO] + auditoria.filas, resumen, \"\\n\".join(partes), doc.Title]\n\n\n# --- Punto de entrada del nodo Python de Dynamo --------------------------\nif \"IN\" in globals():\n    OUT = ejecutar(IN[0], IN[1], IN[2])  # noqa: F821\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "NodeType": "PythonScriptNode",
      "Inputs": [

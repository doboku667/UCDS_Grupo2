    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# -*- coding: utf-8 -*-\n\"\"\"\nNODO 03 - EXPORTAR REPORTE\n==========================\nRutina QA/QC de parámetros y nomenclatura - EC2 MBIM301\n\nEntradas\n    IN[0]  salida completa del NODO 02: [tabla, resumen, mensaje, proyecto]\n    IN[1]  carpeta de salida (str)\n\nSalida\n    OUT = [ruta_detalle, ruta_resumen]  o un texto de error\n\nGenera dos CSV con separador ';' y codificación UTF-8 con BOM, para que\nExcel en configuración regional Perú/España los abra directamente con\ntildes y columnas correctas. El nombre incluye fecha y hora: cada\nejecución deja trazabilidad y nunca sobrescribe un reporte anterior.\n\"\"\"\nimport csv\nimport datetime\nimport io\nimport os\nimport re\n\n\ndef nombre_seguro(texto):\n    texto = re.sub(r\"\\.rvt$\", \"\", texto or \"modelo\", flags=re.I)\n    return re.sub(r\"[^A-Za-z0-9_-]+\", \"_\", texto).strip(\"_\")[:60] or \"modelo\"\n\n\ndef escribir_csv(ruta, filas):\n    with io.open(ruta, \"w\", encoding=\"utf-8-sig\", newline=\"\") as f:\n        w = csv.writer(f, delimiter=\";\")\n        for fila in filas:\n            w.writerow([\"\" if v is None else v for v in fila])\n\n\ndef ejecutar(salida_nodo02, carpeta, ahora=None):\n    if not salida_nodo02 or len(salida_nodo02) < 4:\n        return \"Sin datos del NODO 02: revise la auditoría.\"\n    tabla, resumen, mensaje, proyecto = salida_nodo02[:4]\n    if len(tabla) <= 1:\n        return \"No se generó reporte: la auditoría no evaluó ningún elemento. \" + str(mensaje)\n    if not carpeta:\n        return \"Indique la carpeta de salida.\"\n    carpeta = str(carpeta)\n    try:\n        if not os.path.isdir(carpeta):\n            os.makedirs(carpeta)\n        sello = (ahora or datetime.datetime.now()).strftime(\"%Y%m%d_%H%M%S\")\n        base = os.path.join(carpeta, \"QAQC_%s_%s\" % (nombre_seguro(proyecto), sello))\n        ruta_detalle, ruta_resumen = base + \"_detalle.csv\", base + \"_resumen.csv\"\n        escribir_csv(ruta_detalle, tabla)\n        escribir_csv(ruta_resumen, resumen)\n        return [ruta_detalle, ruta_resumen]\n    except (IOError, OSError) as ex:\n        return \"No se pudo escribir el reporte (¿archivo abierto en Excel o carpeta sin permisos?): %s\" % ex\n\n\n# --- Punto de entrada del nodo Python de Dynamo --------------------------\nif \"IN\" in globals():\n    OUT = ejecutar(IN[0], IN[1])  # noqa: F821\n",
